---
title: "Extras"
description: "Contenido extra de la comunidad."
layout: base.njk
pagination:
  data: extrasGl
  size: 8
  alias: extraPagina
permalink: "{{ '/extra/' if pagination.pageNumber == 0 else '/extra/' + (pagination.pageNumber + 1) + '/' }}"
---
<section class="seccion">
  <h1>✨ Extras</h1>
  <p class="seccion-sub">Videos extra de la comunidad GL</p>

  <section class="reproductor-principal" aria-label="Reproductor de Extras">
    <div class="video-wrapper">
      <iframe src="https://www.youtube.com/embed/{{ extrasGl[0].youtubeId }}" title="{{ extrasGl[0].titulo }}" loading="lazy" allow="autoplay; fullscreen" allowfullscreen></iframe>
    </div>
    <p class="reproductor-titulo">Reproduciendo ahora: {{ extrasGl[0].titulo }}{% if extrasGl[0].canal %} · {{ extrasGl[0].canal }}{% endif %}</p>
  </section>

  <div class="grid-tarjetas grid-2">
    {% for video in extraPagina %}
      {% include "tarjeta-video.njk" %}
    {% endfor %}
  </div>

  {% set totalPaginas = pagination.pages.length %}
  {% set paginaActual = pagination.pageNumber + 1 %}
  <nav class="paginacion" aria-label="Paginación de Extras">
    {% if pagination.href.previous %}<a href="{{ pagination.href.previous }}">‹ Anterior</a>{% endif %}
    {% for pageEntry in pagination.pages %}
      {% set numero = loop.index %}
      {% set seMuestra = (numero == 1 or numero == totalPaginas or (numero >= paginaActual - 2 and numero <= paginaActual + 2)) %}
      {% if seMuestra %}
        {% set anteriorSeMuestra = (numero - 1 == 1 or numero - 1 == totalPaginas or (numero - 1 >= paginaActual - 2 and numero - 1 <= paginaActual + 2)) %}
        {% if numero > 1 and not anteriorSeMuestra %}
          <span class="paginacion-puntos">…</span>
        {% endif %}
        <a href="{{ pagination.hrefs[loop.index0] }}"
           class="{% if numero == paginaActual %}activo{% endif %}">{{ numero }}</a>
      {% endif %}
    {% endfor %}
    {% if pagination.href.next %}<a href="{{ pagination.href.next }}">Siguiente ›</a>{% endif %}
  </nav>
</section>

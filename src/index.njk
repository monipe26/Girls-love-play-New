---
title: Inicio
description: Series, noticias, OST y todo sobre el mundo Girls Love (GL).
layout: base.njk
---
<section class="hero carrusel" aria-label="Destacados">
  <div class="carrusel-track">

    <!-- Banner 1: publicidad -->
    <!-- TODO: reemplazar "imagen" por el banner publicitario real cuando lo tengan -->
    <div class="carrusel-slide">
      <img src="/assets/images/banner-1.jpg" alt="Publicidad" width="1200" height="500">
    </div>

    <!-- Banner 2: última nota de Mundo GL -->
    {% set ultimoMundoGl = collections.mundoGl | first %}
    <div class="carrusel-slide">
      <span class="badge badge-rosa hero-badge">Mundo GL</span>
      <img src="{{ ultimoMundoGl.data.imagen }}" alt="{{ ultimoMundoGl.data.title }}" width="1200" height="500">
      <div class="hero-texto">
        <h1>{{ ultimoMundoGl.data.title }}</h1>
        <p>{{ ultimoMundoGl.data.resumen }}</p>
        <div class="hero-pie">
          <time datetime="{{ ultimoMundoGl.date }}">{{ ultimoMundoGl.date | readableDate | upper }}</time>
          <a href="{{ ultimoMundoGl.url }}" class="btn-primario">Leer más →</a>
        </div>
      </div>
    </div>

    <!-- Banner 3: última noticia -->
    {% set ultimaNoticia = collections.noticias | first %}
    <div class="carrusel-slide">
      <span class="badge badge-rosa hero-badge">Última noticia</span>
      <img src="{{ ultimaNoticia.data.imagen }}" alt="{{ ultimaNoticia.data.title }}" width="1200" height="500">
      <div class="hero-texto">
        <h1>{{ ultimaNoticia.data.title }}</h1>
        <p>{{ ultimaNoticia.data.resumen }}</p>
        <div class="hero-pie">
          <time datetime="{{ ultimaNoticia.date }}">{{ ultimaNoticia.date | readableDate | upper }}</time>
          <a href="{{ ultimaNoticia.url }}" class="btn-primario">Leer más →</a>
        </div>
      </div>
    </div>

  </div>
  <button class="carrusel-btn prev" aria-label="Anterior">‹</button>
  <button class="carrusel-btn next" aria-label="Siguiente">›</button>
</section>

{% include "iconos-nav.njk" %}

<div class="layout-home">
  <div class="columna-principal">

    <section class="seccion seccion-ultima-noticia" aria-labelledby="tit-ultima">
      <div class="seccion-cabecera">
        <h2 id="tit-ultima">📰 Última noticia</h2>
        <a href="/noticias/" class="ver-mas">Ver todo →</a>
      </div>
      {% set ultimaNoticia = collections.noticias | first %}
      <a href="{{ ultimaNoticia.url }}" class="tarjeta-grande">
        <img src="{{ ultimaNoticia.data.imagen }}" alt="{{ ultimaNoticia.data.title }}" width="800" height="420" loading="lazy">
        <div class="tarjeta-grande-info">
          <span class="badge badge-rosa">GL</span>
          <h3>{{ ultimaNoticia.data.title }}</h3>
          <p>{{ ultimaNoticia.data.resumen }}</p>
          <time datetime="{{ ultimaNoticia.date }}">{{ ultimaNoticia.date | readableDate | upper }}</time>
          <span class="btn-primario">Leer más →</span>
        </div>
      </a>
    </section>

    <section class="seccion seccion-noticias-destacadas" aria-labelledby="tit-noticias">
      <div class="seccion-cabecera">
        <h2 id="tit-noticias">📰 Últimas noticias</h2>
        <a href="/noticias/" class="ver-mas">Ver todo →</a>
      </div>
      <div class="noticias-destacadas">
        <ul class="noticias-lista">
          {% for nota in collections.noticias | limit(9) %}
          <li>
            <a href="{{ nota.url }}">
              <img src="{{ nota.data.imagen }}" alt="{{ nota.data.title }}" width="90" height="70" loading="lazy">
              <div>
                <span class="noticia-fecha">{{ nota.date | readableDate | upper }} · <span class="badge-texto">Noticias</span></span>
                <p>{{ nota.data.title }}</p>
              </div>
            </a>
          </li>
          {% endfor %}
        </ul>
      </div>
    </section>

    <section class="seccion seccion-mundo-comunidad">
      <div class="mundo-gl-bloque">
        <div class="seccion-cabecera">
          <h2>🌐 Mundo GL</h2>
          <a href="/mundo-gl/" class="ver-mas">Ver todo →</a>
        </div>
        <ul class="mundo-gl-grid">
          {% for nota in collections.mundoGl | limit(6) %}
          <li>
            <a href="{{ nota.url }}">
              <img src="{{ nota.data.imagen }}" alt="{{ nota.data.title }}" width="130" height="130" loading="lazy">
              <div>
                <h3>{{ nota.data.title }}</h3>
                <p>{{ nota.data.resumen }}</p>
              </div>
            </a>
          </li>
          {% endfor %}
        </ul>
      </div>
    </section>

  </div>

  {% include "sidebar.njk" %}
</div>

---
title: Inicio
description: Series, noticias, OST y todo sobre el mundo Girls Love (GL).
layout: base.njk
---
<section class="hero carrusel" aria-label="Última noticia destacada">
  <div class="carrusel-track">
    <div class="carrusel-slide">
      <span class="badge badge-rosa hero-badge">Última noticia</span>
      <img src="/assets/placeholder/hero.jpg" alt="" width="1200" height="500">
      <div class="hero-texto">
        <h1>Nuevo drama GL tailandés ya tiene a sus protagonistas</h1>
        <p>La esperada serie "El mismo cielo, diferentes caminos" presenta a sus dos protagonistas principales.</p>
        <div class="hero-pie">
          <time datetime="2026-09-24">24 SEP 2026</time>
          <a href="#" class="btn-primario">Leer más →</a>
        </div>
      </div>
    </div>
    {% for banner in banners %}
    <a href="{{ banner.enlace }}" class="carrusel-slide">
      <img src="{{ banner.imagen }}" alt="{{ banner.alt }}" width="1200" height="500">
    </a>
    {% endfor %}
  </div>
  <button class="carrusel-btn prev" aria-label="Anterior">‹</button>
  <button class="carrusel-btn next" aria-label="Siguiente">›</button>
</section>

{% include "iconos-nav.njk" %}

<div class="layout-home">
  <div class="columna-principal">

    <section class="seccion seccion-ultima-noticia" aria-labelledby="tit-ultima">
      <div class="seccion-cabecera">
        <h2 id="tit-ultima">📰 Última noticia</h2>
        <a href="/noticias/" class="ver-mas">Ver todo →</a>
      </div>
      <a href="#" class="tarjeta-grande">
        <img src="/assets/placeholder/ultima-noticia.jpg" alt="" width="800" height="420" loading="lazy">
        <div class="tarjeta-grande-info">
          <span class="badge badge-rosa">GL</span>
          <h3>Nuevo drama GL tailandés ya tiene a sus protagonistas</h3>
          <p>La esperada serie "El mismo cielo", diferentes caminos, presenta a sus dos protagonistas principales.</p>
          <time datetime="2026-09-24">24 SEP 2026</time>
          <span class="btn-primario">Leer más →</span>
        </div>
      </a>
    </section>

    <section class="seccion seccion-noticias-destacadas" aria-labelledby="tit-noticias">
      <div class="seccion-cabecera">
        <h2 id="tit-noticias">📰 Últimas noticias</h2>
        <a href="/noticias/" class="ver-mas">Ver todo →</a>
      </div>
      <div class="noticias-destacadas">
        <ul class="noticias-lista">
          <li>
            <img src="/assets/placeholder/noticia-1.jpg" alt="" width="90" height="70" loading="lazy">
            <div>
              <span class="noticia-fecha">24 SEP 2026 · <span class="badge-texto">Catálogo</span></span>
              <p>Faye confirma nuevo proyecto junto a una reconocida actriz</p>
            </div>
          </li>
          <li>
            <img src="/assets/placeholder/noticia-2.jpg" alt="" width="90" height="70" loading="lazy">
            <div>
              <span class="noticia-fecha">23 SEP 2026 · <span class="badge-texto">Noticias</span></span>
              <p>GagaQOLala presenta sus estrenos de octubre</p>
            </div>
          </li>
          <li>
            <img src="/assets/placeholder/noticia-3.jpg" alt="" width="90" height="70" loading="lazy">
            <div>
              <span class="noticia-fecha">22 SEP 2026 · <span class="badge-texto">Mundo GL</span></span>
              <p>El fandom GL se reúne en Bangkok por un evento especial</p>
            </div>
          </li>
          <li>
            <img src="/assets/placeholder/noticia-4.jpg" alt="" width="90" height="70" loading="lazy">
            <div>
              <span class="noticia-fecha">21 SEP 2026 · <span class="badge-texto">Ships GL</span></span>
              <p>Ya disponible el soundtrack de "Love in the Fast Lane"</p>
            </div>
          </li>
          <li>
            <img src="/assets/placeholder/noticia-5.jpg" alt="" width="90" height="70" loading="lazy">
            <div>
              <span class="noticia-fecha">20 SEP 2026 · <span class="badge-texto">Catálogo</span></span>
              <p>My Dear, My Rival estrena tráiler oficial</p>
            </div>
          </li>
          <li>
            <img src="/assets/placeholder/noticia-6.jpg" alt="" width="90" height="70" loading="lazy">
            <div>
              <span class="noticia-fecha">19 SEP 2026 · <span class="badge-texto">Actrices</span></span>
              <p>Mint Ranchrawee habla de su próximo proyecto GL</p>
            </div>
          </li>
        </ul>

        <div class="tarjeta-destacada">
          <!-- TODO Paso 6: reemplazar por el video real (tráiler o primer episodio) de la serie que se elija -->
          <a href="/series-tv/" class="tarjeta-destacada-video" aria-label="Ver Blank: The Series en Series">
            <img src="https://i.ytimg.com/vi/dQw4w9WgXcQ/hqdefault.jpg" alt="" width="420" height="236" loading="lazy">
            <span class="comunidad-video-play" aria-hidden="true">▶</span>
          </a>
          <div class="tarjeta-destacada-info">
            <span class="badge badge-rosa">Series</span>
            <h3>Blank: The Series</h3>
            <p>La serie que todos están esperando.</p>
            <a href="/series-tv/" class="btn-primario">Ver serie →</a>
          </div>
        </div>
      </div>
    </section>

    <section class="seccion seccion-mundo-comunidad">
      <div class="mundo-gl-bloque">
        <div class="seccion-cabecera">
          <h2>🌐 Mundo GL</h2>
          <a href="/mundo-gl/" class="ver-mas">Ver todo →</a>
        </div>
        <ul class="mundo-gl-grid">
          {% for nota in collections.mundoGl | limit(6) %}
          <li>
            <a href="{{ nota.url }}">
              <img src="{{ nota.data.imagen }}" alt="{{ nota.data.title }}" width="130" height="130" loading="lazy">
              <div>
                <h3>{{ nota.data.title }}</h3>
                <p>{{ nota.data.resumen }}</p>
              </div>
            </a>
          </li>
          {% endfor %}
        </ul>
      </div>
    </section>

  </div>

  {% include "sidebar.njk" %}
</div>

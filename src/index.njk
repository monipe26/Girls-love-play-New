---
title: Inicio
description: "Tu portal GL en español: enterate de los estrenos, conocé a las actrices y a los ships, y encontrá tu próxima serie Girls Love."
layout: base.njk
seoTitle: "Girls Love Play · Series GL, noticias y Mundo GL en español"
---
<section class="hero carrusel" aria-label="Destacados">
  <div class="carrusel-track">

    <!-- Banner 1: banner propio (se edita desde el panel: Banner del inicio) -->
    {% if bannerInicio.activa %}
    <div class="carrusel-slide" style="--bg:url('{{ bannerInicio.imagen }}'); --foco:center">
      {% if bannerInicio.enlace %}<a href="{{ bannerInicio.enlace }}"{% if bannerInicio.enlace.startsWith("http") %} target="_blank" rel="noopener noreferrer"{% endif %} class="carrusel-enlace">{% endif %}
      <img src="{{ bannerInicio.imagen }}" alt="{{ bannerInicio.alt }}" width="1600" height="533">
      {% if bannerInicio.enlace %}</a>{% endif %}
    </div>
    {% endif %}

    <!-- Banner 2: última nota de Mundo GL -->
    {% set ultimoMundoGl = collections.mundoGl | first %}
    <div class="carrusel-slide" style="--bg:url('{{ ultimoMundoGl.data.imagen }}'); --foco:{{ ultimoMundoGl.data.focoCarrusel or 'center 30%' }}">
      <span class="badge badge-rosa hero-badge">Mundo GL</span>
      <img src="{{ ultimoMundoGl.data.imagen }}" alt="{{ ultimoMundoGl.data.title }}" width="1200" height="500">
      <div class="hero-texto">
        <h1>{{ ultimoMundoGl.data.title }}</h1>
        <p>{{ ultimoMundoGl.data.resumen }}</p>
        <div class="hero-pie">
          <time datetime="{{ ultimoMundoGl.date }}">{{ ultimoMundoGl.date | readableDate | upper }}</time>
          <a href="{{ ultimoMundoGl.url }}" class="btn-primario">Leer más →</a>
        </div>
      </div>
    </div>

    <!-- Banner 3: última noticia -->
    {% set ultimaNoticia = collections.noticias | first %}
    <div class="carrusel-slide" style="--bg:url('{{ ultimaNoticia.data.imagen }}'); --foco:{{ ultimaNoticia.data.focoCarrusel or 'center 30%' }}">
      <span class="badge badge-rosa hero-badge">Última noticia</span>
      <img src="{{ ultimaNoticia.data.imagen }}" alt="{{ ultimaNoticia.data.title }}" width="1200" height="500">
      <div class="hero-texto">
        <h1>{{ ultimaNoticia.data.title }}</h1>
        <p>{{ ultimaNoticia.data.resumen }}</p>
        <div class="hero-pie">
          <time datetime="{{ ultimaNoticia.date }}">{{ ultimaNoticia.date | readableDate | upper }}</time>
          <a href="{{ ultimaNoticia.url }}" class="btn-primario">Leer más →</a>
        </div>
      </div>
    </div>

  </div>
  <button class="carrusel-btn prev" aria-label="Anterior">‹</button>
  <button class="carrusel-btn next" aria-label="Siguiente">›</button>
</section>

{% include "iconos-nav.njk" %}

<div class="layout-home">
  <div class="columna-principal">

    <section class="seccion seccion-ultima-noticia" aria-labelledby="tit-ultima">
      <div class="seccion-cabecera">
        <h2 id="tit-ultima">📰 Última noticia</h2>
        <a href="/noticias/" class="ver-mas">Ver todo →</a>
      </div>
      {% set ultimaNoticia = collections.noticias | first %}
      <a href="{{ ultimaNoticia.url }}" class="tarjeta-grande">
        <img src="{{ ultimaNoticia.data.imagen }}" alt="{{ ultimaNoticia.data.title }}" width="800" height="420" loading="lazy">
        <div class="tarjeta-grande-info">
          <span class="badge badge-rosa">GL</span>
          <h3>{{ ultimaNoticia.data.title }}</h3>
          <p>{{ ultimaNoticia.data.resumen }}</p>
          <time datetime="{{ ultimaNoticia.date }}">{{ ultimaNoticia.date | readableDate | upper }}</time>
          <span class="btn-primario">Leer más →</span>
        </div>
      </a>
    </section>

    <section class="seccion seccion-noticias-destacadas" aria-labelledby="tit-noticias">
      <div class="seccion-cabecera">
        <h2 id="tit-noticias">📰 Últimas noticias</h2>
        <a href="/noticias/" class="ver-mas">Ver todo →</a>
      </div>
      <div class="noticias-destacadas">
        <ul class="noticias-lista">
          {% for nota in collections.noticias | limit(6) %}
          <li>
            <a href="{{ nota.url }}">
              <img src="{{ nota.data.imagen }}" alt="{{ nota.data.title }}" width="90" height="70" loading="lazy">
              <div>
                <span class="noticia-fecha">{{ nota.date | readableDate | upper }} · <span class="badge-texto">Noticias</span></span>
                <p>{{ nota.data.title }}</p>
              </div>
            </a>
          </li>
          {% endfor %}
        </ul>
      </div>
    </section>

    {# Calendario SOLO en móvil: entre "Últimas noticias" y "Mundo GL".
       En escritorio no se ve acá (sigue en la barra lateral). #}
    <div class="seccion calendario-movil">
      {% include "widget-calendario.njk" %}
    </div>

    <section class="seccion seccion-mundo-comunidad">
      <div class="mundo-gl-bloque">
        <div class="seccion-cabecera">
          <h2>🌐 Mundo GL</h2>
          <a href="/mundo-gl/" class="ver-mas">Ver todo →</a>
        </div>
        <ul class="mundo-gl-grid">
          {% for nota in collections.mundoGl | limit(6) %}
          <li>
            <a href="{{ nota.url }}">
              <img src="{{ nota.data.imagen }}" alt="{{ nota.data.title }}" width="600" height="338" loading="lazy">
              <div>
                <h3>{{ nota.data.title }}</h3>
                <p>{{ nota.data.resumen }}</p>
              </div>
            </a>
          </li>
          {% endfor %}
        </ul>
      </div>
    </section>

  </div>

  {% include "sidebar.njk" %}
</div>

<!-- 🎂 Aviso de cumpleaños: solo en el home, no invasivo, se puede cerrar. -->
<style>
  #aviso-cumple-index {
    position: fixed;
    inset: 0;
    z-index: 9998;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 14px;
    padding: 24px;
    pointer-events: none;
  }
  #aviso-cumple-index:empty { display: none; }
  #aviso-cumple-index::before {
    content: "";
    position: fixed;
    inset: 0;
    background: rgba(0, 0, 0, 0.62);
    z-index: -1;
  }
  .aviso-cumple-card {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 10px;
    background: linear-gradient(160deg, #ff4fd8, #8f5cff);
    border-radius: 20px;
    padding: 36px 26px 26px;
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.4), 0 0 20px rgba(255, 79, 216, 0.4);
    animation: aviso-cumple-entrada 0.4s ease;
    max-width: 300px;
    width: 100%;
    pointer-events: auto;
  }
  @keyframes aviso-cumple-entrada {
    from { opacity: 0; transform: translateY(16px) scale(0.96); }
    to { opacity: 1; transform: translateY(0) scale(1); }
  }
  .aviso-cumple-foto {
    width: 88px;
    height: 88px;
    border-radius: 50%;
    object-fit: cover;
    flex-shrink: 0;
    border: 3px solid rgba(255, 255, 255, 0.7);
    margin-bottom: 4px;
  }
  .aviso-cumple-texto { display: flex; flex-direction: column; align-items: center; gap: 6px; min-width: 0; }
  .aviso-cumple-nombre { margin: 0; color: #fff; font-weight: 800; font-size: 16px; }
  .aviso-cumple-msj { margin: 0; color: #fff; font-size: 13px; opacity: 0.95; }
  .aviso-cumple-link {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    margin-top: 6px;
    background: rgba(255, 255, 255, 0.18);
    color: #fff;
    font-size: 12px;
    font-weight: 700;
    padding: 8px 16px;
    border-radius: 18px;
    text-decoration: none;
    width: fit-content;
  }
  .aviso-cumple-link:hover { background: rgba(255, 255, 255, 0.3); }
  .aviso-cumple-cerrar {
    position: absolute;
    top: 10px;
    right: 10px;
    background: rgba(0, 0, 0, 0.18);
    border: none;
    border-radius: 50%;
    color: #fff;
    font-size: 16px;
    cursor: pointer;
    opacity: 0.9;
    line-height: 1;
    width: 30px;
    height: 30px;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .aviso-cumple-cerrar:hover { opacity: 1; background: rgba(0, 0, 0, 0.3); }
  @media (max-width: 700px) {
    .aviso-cumple-card { max-width: 280px; }
  }
</style>
<div id="aviso-cumple-index"></div>
<script>window.actricesCumpleData = {{ cumpleData | dump | safe }};</script>
<script src="/js/cumpleanos.js" defer></script>

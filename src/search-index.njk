---
permalink: /search-index.json
eleventyExcludeFromCollections: true
---
{#- Índice del buscador: una lista con TODO lo que se puede encontrar en el
    sitio. Se regenera solo en cada build (agregar una serie/noticia nueva
    la suma automáticamente). Campos: t=título, u=link, k=tipo, i=imagen,
    x=texto corto, a=año. -#}
{%- set items = [] -%}
{%- for s in collections.catalogoSeries -%}
  {%- set _reparto = [] -%}
  {%- for r in s.data.reparto -%}{%- set _ = _reparto.push(r.actriz + " " + (r.apodo or "")) -%}{%- endfor -%}
  {%- set _ = items.push({ "t": s.data.titulo, "u": s.url, "k": "Catálogo", "i": s.data.portada, "x": ((s.data.sinopsis or "") + " " + (_reparto | join(" ")) + " " + (s.data.genero or "") + " " + (s.data.pais or "")) | trim }) -%}
{%- endfor -%}
{%- for s in seriesTv -%}
  {%- set _ = items.push({ "t": s.titulo, "u": "/series-gl/" + ((s.slug or s.titulo) | slugify) + "/", "k": "Series", "i": s.portada, "x": s.sinopsis, "a": s.anio }) -%}
{%- endfor -%}
{%- for n in collections.noticias -%}
  {%- set _ = items.push({ "t": n.data.title, "u": n.url, "k": "Noticias", "i": n.data.imagen, "x": n.data.resumen }) -%}
{%- endfor -%}
{%- for n in collections.mundoGl -%}
  {%- set _ = items.push({ "t": n.data.title, "u": n.url, "k": "Mundo GL", "i": n.data.imagen, "x": n.data.resumen }) -%}
{%- endfor -%}
{%- for a in actricesGl -%}
  {%- set _ = items.push({ "t": a.nombre, "u": "/actrices/letra/" + (a.nombre | letraActrizSlug) + "/", "k": "Actrices", "i": a.foto, "x": ((a.apodo or "") + " " + (a.nombreOriginal or "")) | trim }) -%}
{%- endfor -%}
{#- Videos de OST, Extras, Comunidad y Próximamente: cada uno apunta a SU propia
    página (/ost/slug/, /extra/slug/, etc.), no a la lista de la sección. -#}
{%- for v in videoPaginas -%}
  {%- set _ = items.push({ "t": v.titulo, "u": "/" + v.base + "/" + v.slug + "/", "k": v.seccion, "i": "https://i.ytimg.com/vi/" + v.youtubeId + "/hqdefault.jpg", "x": ((v.descripcion or v.sinopsis or v.canal) | trim) }) -%}
{%- endfor -%}
{{ items | dump | safe }}

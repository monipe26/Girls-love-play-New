---
title: Noticias GL
description: Estrenos, fechas y novedades del mundo GL.
layout: base.njk
pagination:
  data: collections.noticias
  size: 8
  alias: notiPagina
permalink: "{{ '/noticias/' if pagination.pageNumber == 0 else '/noticias/' + (pagination.pageNumber + 1) + '/' }}"
---
<section class="seccion">
  <h1>📰 Noticias GL</h1>
  <p class="seccion-sub">Estrenos, fechas y novedades</p>

  <div class="grid-tarjetas grid-2">
    {% for nota in notiPagina %}
      {% include "tarjeta-noticia.njk" %}
    {% endfor %}
  </div>

  <nav class="paginacion" aria-label="Paginación de noticias">
    {% if pagination.href.previous %}<a href="{{ pagination.href.previous }}">‹ Anterior</a>{% endif %}
    {% for pageEntry in pagination.pages %}
      {% set numero = loop.index %}
      <a href="{{ pagination.hrefs[loop.index0] }}"
         class="{% if numero == pagination.pageNumber + 1 %}activo{% endif %}">{{ numero }}</a>
    {% endfor %}
    {% if pagination.href.next %}<a href="{{ pagination.href.next }}">Siguiente ›</a>{% endif %}
  </nav>
</section>

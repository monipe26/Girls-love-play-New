---
title: "Series"
description: "Series con temática GL: mirá el capítulo y elegí la próxima serie sin salir de la página."
layout: base.njk
---
{% set primera = seriesTv[0] %}
{% if primera.playlist %}{% set srcInicial = "videoseries?list=" + primera.playlist %}
{% elif primera.videos and primera.videos.length %}{% set srcInicial = primera.videos[0] %}
{% else %}{% set srcInicial = primera.youtubeId %}{% endif %}
<section class="seccion seccion-series-tv">
  <h1>📺 Series</h1>
  <p class="seccion-sub seccion-sub-reproductor">Elegí una serie de la grilla y se reproduce acá arriba</p>

  <section class="reproductor-principal" data-reproductor-series-tv aria-label="Reproductor de Series">
    <div class="video-wrapper">
      <iframe src="https://www.youtube.com/embed/{{ srcInicial }}" title="{{ seriesTv[0].titulo }}" loading="lazy" allow="autoplay; fullscreen" allowfullscreen></iframe>
    </div>

    <p class="reproductor-titulo">Reproduciendo ahora: {{ seriesTv[0].titulo }} ({{ seriesTv[0].anio }})</p>

    <div class="lista-partes lista-partes-series-tv" data-partes-series-tv aria-label="Partes de la serie" hidden></div>

    <div class="reproductor-nav" data-nav-series-tv>
      <button type="button" class="btn-nav-episodio" data-nav="prev" disabled>‹ Episodio anterior</button>
      <span class="reproductor-corazon" aria-hidden="true">
        <!-- TODO: reemplazar por <img src="/assets/icons/corazon.png" alt=""> (favorito) cuando se suba la imagen -->
        ♥
      </span>
      <button type="button" class="btn-nav-episodio" data-nav="next">Episodio siguiente ›</button>
    </div>

    <p class="reproductor-sinopsis">{{ seriesTv[0].sinopsis }}</p>
  </section>

  <div class="grid-tarjetas grid-series-tv">
    {% for serie in seriesTv %}
      {% include "tarjeta-serie-tv.njk" %}
    {% endfor %}
  </div>
</section>

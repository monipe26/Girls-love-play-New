---
title: "Actrices GL"
description: "Perfiles de actrices del mundo GL."
layout: base.njk
pagination:
  data: actricesGl
  size: 12
  alias: actricesPagina
permalink: "{{ '/actrices/' if pagination.pageNumber == 0 else '/actrices/' + (pagination.pageNumber + 1) + '/' }}"
---
<section class="seccion">
  <h1>👑 Actrices GL</h1>
  <p class="seccion-sub">Conocé a las protagonistas del universo GL</p>

  <div class="letras-filtro" data-filtro-actrices>
    <button type="button" class="letra-pill activo" data-letra="todas">Todas</button>
    {% for letra in actricesPagina | primerasLetras %}
    <button type="button" class="letra-pill" data-letra="{{ letra }}">{{ letra }}</button>
    {% endfor %}
  </div>

  <div class="grid-actrices">
    {% for actriz in actricesPagina %}
      {% include "tarjeta-actriz.njk" %}
    {% endfor %}
  </div>

  {% set totalPaginas = pagination.pages.length %}
  {% set paginaActual = pagination.pageNumber + 1 %}
  <nav class="paginacion" aria-label="Paginación de actrices">
    {% if pagination.href.previous %}<a href="{{ pagination.href.previous }}">‹ Anterior</a>{% endif %}
    {% for pageEntry in pagination.pages %}
      {% set numero = loop.index %}
      {% set seMuestra = (numero == 1 or numero == totalPaginas or (numero >= paginaActual - 2 and numero <= paginaActual + 2)) %}
      {% if seMuestra %}
        {% set anteriorSeMuestra = (numero - 1 == 1 or numero - 1 == totalPaginas or (numero - 1 >= paginaActual - 2 and numero - 1 <= paginaActual + 2)) %}
        {% if numero > 1 and not anteriorSeMuestra %}
          <span class="paginacion-puntos">…</span>
        {% endif %}
        <a href="{{ pagination.hrefs[loop.index0] }}"
           class="{% if numero == paginaActual %}activo{% endif %}">{{ numero }}</a>
      {% endif %}
    {% endfor %}
    {% if pagination.href.next %}<a href="{{ pagination.href.next }}">Siguiente ›</a>{% endif %}
  </nav>
</section>

---
layout: base.njk
ogTipo: actriz
pagination:
  data: actricesWeb
  size: 1
  alias: actriz
permalink: "/actrices/{{ actriz.slug }}/"
eleventyExcludeFromCollections: true
---
<section class="seccion seccion-actrices">
  <nav class="migas" aria-label="Migas de pan">
    <ol>
      <li><a href="/">Inicio</a></li>
      <li><a href="/actrices/">Actrices GL</a></li>
      <li aria-current="page">{{ actriz.nombre }}</li>
    </ol>
  </nav>

  <div class="ficha-actriz-cabecera">
    <img src="{{ actriz.foto }}" alt="Foto de {{ actriz.nombre }}" class="ficha-actriz-foto" width="300" height="400">
    <div class="ficha-actriz-texto">
      <h1>{{ actriz.nombre }}</h1>
      {% if actriz.nombreOriginal %}<p class="ficha-actriz-original">{{ actriz.nombreOriginal }}</p>{% endif %}
      <ul class="ficha-actriz-datos">
        {% if actriz.apodo %}<li>💕 {{ actriz.apodo }}</li>{% endif %}
        {% if actriz.nacimiento %}<li>🎂 {{ actriz.nacimiento | fechaLarga }}</li>{% endif %}
        {% if actriz.nacimiento %}<li>🎈 {{ actriz.nacimiento | edad }} años</li>{% endif %}
        {% if actriz.nacionalidad %}<li>🌏 {{ actriz.nacionalidad }}</li>{% endif %}
      </ul>
    </div>
  </div>

  {% if actriz.biografia %}
  <div class="ficha-actriz-seccion">
    <h2>📝 Biografía</h2>
    <p>{{ actriz.biografia }}</p>
  </div>
  {% endif %}

  {% if actriz.series and actriz.series.length %}
  <div class="ficha-actriz-seccion">
    <h2>🎬 Series</h2>
    <div class="ficha-actriz-badges">
      {% for serie in actriz.series %}
      <span class="badge-serie">🎬 {{ serie.titulo }}{% if serie.anio %} ({{ serie.anio }}){% endif %}</span>
      {% endfor %}
    </div>
  </div>
  {% endif %}

  {% if actriz.shipSlug %}
  {% for s in shipsWeb %}{% if s.slug == actriz.shipSlug %}
  <div class="ficha-actriz-seccion">
    <h2>💕 Ship</h2>
    <a href="/ships/{{ s.slug }}/" class="badge-ship">💕 {{ s.ship }}</a>
  </div>
  {% endif %}{% endfor %}
  {% endif %}

  {% if actriz.instagram %}
  <div class="ficha-actriz-seccion">
    <h2>📷 Instagram</h2>
    <a href="{{ actriz.instagram }}" class="btn-primario" target="_blank" rel="noopener">📷 Ver perfil</a>
  </div>
  {% endif %}

  <p class="articulo-volver"><a href="/actrices/" class="btn-primario">💖 Ver todas las actrices</a></p>
</section>

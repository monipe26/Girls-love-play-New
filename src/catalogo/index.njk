---
title: "Catálogo de series GL"
description: "Catálogo de series Girls Love (GL): portadas, géneros, países, reparto y tráilers. Buscá tu próxima serie."
layout: base.njk
pagination:
  data: collections.catalogoSeries
  size: 20
  alias: catPagina
permalink: "{{ '/catalogo/' if pagination.pageNumber == 0 else '/catalogo/' + (pagination.pageNumber + 1) + '/' }}"
---
<section class="seccion seccion-series-tv">
  <h1>📺 Catálogo</h1>
  <p class="seccion-sub">Todas las series GL en un solo lugar</p>

  <form class="buscador-series" role="search" data-buscador-series data-tipo="Catálogo">
    <label for="buscar-catalogo" class="sr-only">Buscar una serie</label>
    <input type="search" id="buscar-catalogo" placeholder="🔍 Buscar una serie…" autocomplete="off">
    <p class="buscador-series-estado" data-series-estado aria-live="polite"></p>
  </form>
  <div data-resultados-series hidden></div>

  <div data-lista-series>
  <div class="grid-tarjetas grid-series-tv">
    {% for serie in catPagina %}
      {% include "tarjeta-catalogo.njk" %}
    {% endfor %}
  </div>

  {% set totalPaginas = pagination.pages.length %}
  {% set paginaActual = pagination.pageNumber + 1 %}
  <nav class="paginacion" aria-label="Paginación del Catálogo">
    {% if pagination.href.previous %}<a href="{{ pagination.href.previous }}">‹ Anterior</a>{% endif %}
    {% for pageEntry in pagination.pages %}
      {% set numero = loop.index %}
      {% set seMuestra = (numero == 1 or numero == totalPaginas or (numero >= paginaActual - 2 and numero <= paginaActual + 2)) %}
      {% if seMuestra %}
        {% set anteriorSeMuestra = (numero - 1 == 1 or numero - 1 == totalPaginas or (numero - 1 >= paginaActual - 2 and numero - 1 <= paginaActual + 2)) %}
        {% if numero > 1 and not anteriorSeMuestra %}
          <span class="paginacion-puntos">…</span>
        {% endif %}
        <a href="{{ pagination.hrefs[loop.index0] }}"
           class="{% if numero == paginaActual %}activo{% endif %}">{{ numero }}</a>
      {% endif %}
    {% endfor %}
    {% if pagination.href.next %}<a href="{{ pagination.href.next }}">Siguiente ›</a>{% endif %}
  </nav>
  </div>
</section>

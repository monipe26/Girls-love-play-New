{% set _videos = serie.videos or ([serie.youtubeId] if serie.youtubeId else []) %}
<button
  type="button"
  id="serie-{{ serie.titulo | slugify }}"
  class="tarjeta-serie-tv {% if loop.first %}activo{% endif %}"
  data-videos="{{ _videos | join(',') }}"
  data-playlist="{{ serie.playlist or '' }}"
  data-titulo="{{ serie.titulo }} ({{ serie.anio }})"
  data-sinopsis="{{ serie.sinopsis }}"
  aria-label="Reproducir {{ serie.titulo }}"
>
  <span class="tarjeta-serie-tv-portada">
    <img src="{{ serie.portada }}" alt="Portada de {{ serie.titulo }}" width="300" height="450" loading="lazy" decoding="async">
    <span class="tarjeta-serie-tv-play" aria-hidden="true">▶</span>
    <span class="tarjeta-serie-tv-overlay">
      <span class="tarjeta-serie-tv-meta">
        <span class="tarjeta-serie-tv-anio">{{ serie.anio }}</span>
        <span class="tarjeta-serie-tv-genero">{{ serie.genero }}</span>
      </span>
      <span class="tarjeta-serie-tv-sinopsis">{{ serie.sinopsis }}</span>
    </span>
  </span>
  <span class="tarjeta-serie-tv-titulo">{{ serie.titulo }}</span>
</button>

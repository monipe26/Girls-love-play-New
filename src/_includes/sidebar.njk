<aside class="sidebar" aria-label="Barra lateral">

  {% include "widget-calendario.njk" %}

  <section class="widget-publicidad">
    <h2>Publicidad</h2>
    <!-- TODO: reemplazar por el anuncio real (banner/ad-code) cuando lo tengan -->
    <div class="anuncio-placeholder">
      <span>Espacio publicitario</span>
      <span class="anuncio-medida">300 × 250</span>
    </div>
  </section>

  {# Serie destacada: la más nueva de seriesTv.json (año más alto; si hay empate, la que esté primero en el archivo) #}
  {% set ultimaSerie = seriesTv | sort(true, false, "anio") | first %}
  {% if ultimaSerie.videos and ultimaSerie.videos.length %}{% set miniaturaId = ultimaSerie.videos[0] %}
  {% elif ultimaSerie.youtubeId %}{% set miniaturaId = ultimaSerie.youtubeId %}
  {% else %}{% set miniaturaId = "" %}{% endif %}
  <div class="tarjeta-destacada">
    <a href="/series-tv/" class="tarjeta-destacada-video" aria-label="Ver {{ ultimaSerie.titulo }} en Series">
      {# Las playlists de YouTube no tienen miniatura propia: en ese caso se usa la portada #}
      <img src="{% if miniaturaId %}https://i.ytimg.com/vi/{{ miniaturaId }}/hqdefault.jpg{% else %}{{ ultimaSerie.portada }}{% endif %}" alt="" width="420" height="236" loading="lazy">
      <span class="comunidad-video-play" aria-hidden="true">▶</span>
    </a>
    <div class="tarjeta-destacada-info">
      <span class="badge badge-rosa">Series</span>
      <h3>{{ ultimaSerie.titulo }} ({{ ultimaSerie.anio }})</h3>
      <p>{{ ultimaSerie.sinopsis | truncar(110) }}</p>
      <a href="/series-tv/" class="btn-primario">Ver serie →</a>
    </div>
  </div>

  <div class="comunidad-bloque">
    <div class="seccion-cabecera">
      <h2>⭐ Extras</h2>
      <a href="/extra/" class="ver-mas">Ver más →</a>
    </div>
    <ul class="comunidad-lista">
      {% for video in extraGl | limit(1) %}
      <li>
        <button type="button" class="comunidad-video" data-youtube-id="{{ video.youtubeId }}" aria-label="Reproducir {{ video.titulo }}">
          <img src="https://i.ytimg.com/vi/{{ video.youtubeId }}/hqdefault.jpg" alt="" width="200" height="112" loading="lazy">
          <span class="comunidad-video-play" aria-hidden="true">▶</span>
        </button>
        <p class="comunidad-video-titulo">{{ video.titulo | truncar(80) }}</p>
      </li>
      {% endfor %}
    </ul>
  </div>

  <div class="comunidad-bloque">
    <div class="seccion-cabecera">
      <h2>✨ Próximamente</h2>
      <a href="/proximamente/" class="ver-mas">Ver más →</a>
    </div>
    <ul class="comunidad-lista">
      {% for video in proximamenteGl | limit(1) %}
      <li>
        <button type="button" class="comunidad-video" data-youtube-id="{{ video.youtubeId }}" aria-label="Reproducir {{ video.titulo }}">
          <img src="https://i.ytimg.com/vi/{{ video.youtubeId }}/hqdefault.jpg" alt="" width="200" height="112" loading="lazy">
          <span class="comunidad-video-play" aria-hidden="true">▶</span>
        </button>
        <p class="comunidad-video-titulo">{{ video.titulo | truncar(80) }}</p>
      </li>
      {% endfor %}
    </ul>
  </div>

  <div class="comunidad-bloque">
    <div class="seccion-cabecera">
      <h2>🎵 OST</h2>
      <a href="/ost/" class="ver-mas">Ver más →</a>
    </div>
    <ul class="comunidad-lista">
      {% for video in ostGl | limit(1) %}
      <li>
        <button type="button" class="comunidad-video" data-youtube-id="{{ video.youtubeId }}" aria-label="Reproducir {{ video.titulo }}">
          <img src="https://i.ytimg.com/vi/{{ video.youtubeId }}/hqdefault.jpg" alt="" width="200" height="112" loading="lazy">
          <span class="comunidad-video-play" aria-hidden="true">▶</span>
        </button>
        <p class="comunidad-video-titulo">{{ video.titulo | truncar(80) }}</p>
      </li>
      {% endfor %}
    </ul>
  </div>

</aside>

<div class="ticker" aria-label="Últimas noticias">
  <span class="ticker-etiqueta">🔥 Últimas noticias</span>
  <button class="ticker-btn ticker-prev" aria-label="Ver noticia anterior">‹</button>
  <ul class="ticker-lista" id="ticker-lista">
    {% for item in collections.ticker | limit(10) %}
    <li><a href="{{ item.url }}">{{ item.data.title }}</a></li>
    {% endfor %}
  </ul>
  <button class="ticker-btn ticker-next" aria-label="Ver siguiente noticia">›</button>
</div>

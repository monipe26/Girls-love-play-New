<div class="tarjeta-video-caja">
<button type="button" class="tarjeta-video" data-youtube-id="{{ video.youtubeId }}" data-sinopsis="{{ video.sinopsis }}" aria-label="Reproducir {{ video.titulo }}">
  <span class="tarjeta-video-thumb">
    <img src="https://i.ytimg.com/vi/{{ video.youtubeId }}/maxresdefault.jpg" alt="{{ video.titulo }}" width="640" height="360" onerror="this.onerror=null;this.src='https://i.ytimg.com/vi/{{ video.youtubeId }}/hqdefault.jpg'" onload="if(this.naturalWidth&&this.naturalWidth<=120){this.onload=null;this.src='https://i.ytimg.com/vi/{{ video.youtubeId }}/hqdefault.jpg'}" loading="lazy" decoding="async">
    <span class="tarjeta-video-play">▶</span>
  </span>
  <span class="tarjeta-video-info">
    <span class="tarjeta-video-titulo">{{ video.titulo }}</span>
    <span class="tarjeta-video-autor">{{ video.canal }}</span>
    {% if video.sinopsis %}<span class="tarjeta-video-sinopsis">{{ video.sinopsis }}</span>{% endif %}
  </span>
</button>
{% if video.base and video.slug and not video.noindexFinal %}<a class="tarjeta-video-enlace" href="/{{ video.base }}/{{ video.slug }}/">Ver detalle →</a>{% endif %}
</div>

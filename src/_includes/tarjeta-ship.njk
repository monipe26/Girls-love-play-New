{# Variables: ship (un item de shipsGl); usa loop.index0 del for que lo incluye #}
<a href="/ships/{{ ship.slug }}/" class="tarjeta-ship" data-estado="{{ 'vigente' if ship.vigente else 'finalizado' }}" data-letra="{{ ship.ship[0] | upper }}" data-busqueda="{{ ship.ship }} {{ ship.nombres }} {{ ship.series | join(' ') }}">
  <span class="tarjeta-ship-img">
    <img src="{{ ship.img }}" alt="Ship {{ ship.ship }}" width="300" height="400" loading="lazy" decoding="async">
  </span>
  <span class="tarjeta-ship-info">
    <span class="tarjeta-ship-estado {{ 'es-vigente' if ship.vigente else 'es-finalizado' }}">{{ '✅ Vigente' if ship.vigente else '❌ Ship finalizado' }} · {% include "bandera-th.njk" %} {{ ship.pais }}</span>
    <span class="tarjeta-ship-nombre">{{ ship.ship }}</span>
    <span class="tarjeta-ship-actrices">{{ ship.nombres }}</span>
    <span class="tarjeta-ship-series">🎬 {% for s in ship.series %}{% if loop.index0 < 2 %}{% if loop.index0 > 0 %}, {% endif %}{{ s }}{% endif %}{% endfor %}{% if ship.series.length > 2 %}...{% endif %}</span>
  </span>
</a>

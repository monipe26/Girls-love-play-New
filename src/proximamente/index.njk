---
title: "Próximamente GL"
description: "Series y contenido que se viene."
layout: base.njk
pagination:
  data: proximamenteGl
  size: 9
  alias: proximamentePagina
permalink: "{{ '/proximamente/' if pagination.pageNumber == 0 else '/proximamente/' + (pagination.pageNumber + 1) + '/' }}"
---
<section class="seccion">
  <h1>🎬 Próximamente GL</h1>
  <p class="seccion-sub">Series y contenido que se viene</p>

  <section class="reproductor-principal" aria-label="Reproductor de Próximamente GL">
    <div class="video-wrapper">
      <iframe src="https://www.youtube.com/embed/{{ proximamenteGl[0].youtubeId }}" title="{{ proximamenteGl[0].titulo }}" loading="lazy" allow="autoplay; fullscreen" allowfullscreen></iframe>
    </div>
    <p class="reproductor-titulo">Reproduciendo ahora: {{ proximamenteGl[0].titulo }}</p>
  </section>

  <div class="grid-tarjetas grid-2">
    {% for video in proximamentePagina %}
      {% include "tarjeta-video.njk" %}
    {% endfor %}
  </div>

  <nav class="paginacion" aria-label="Paginación de Próximamente GL">
    {% if pagination.href.previous %}<a href="{{ pagination.href.previous }}">‹ Anterior</a>{% endif %}
    {% for pageEntry in pagination.pages %}
      {% set numero = loop.index %}
      <a href="{{ pagination.hrefs[loop.index0] }}"
         class="{% if numero == pagination.pageNumber + 1 %}activo{% endif %}">{{ numero }}</a>
    {% endfor %}
    {% if pagination.href.next %}<a href="{{ pagination.href.next }}">Siguiente ›</a>{% endif %}
  </nav>
</section>

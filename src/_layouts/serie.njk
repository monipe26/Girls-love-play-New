---
layout: base.njk
---
<article class="ficha-serie">
  <div class="ficha-serie-cabecera">
    <img src="{{ portada }}" alt="Portada de {{ titulo }}" width="300" height="450" class="ficha-portada">
    <div class="ficha-info">
      <h1>{{ titulo }} <span class="ficha-anio">({{ anio }})</span></h1>

      <dl class="ficha-datos">
        {% if genero %}
        <div class="ficha-dato">
          <dt>Género</dt>
          <dd>{{ genero }}</dd>
        </div>
        {% endif %}
        {% if reparto and reparto.length %}
        <div class="ficha-dato">
          <dt>Reparto</dt>
          <dd>{{ reparto | join(", ") }}</dd>
        </div>
        {% endif %}
        {% if puntaje %}
        <div class="ficha-dato">
          <dt>Puntaje</dt>
          <dd>⭐ {{ puntaje }}/10</dd>
        </div>
        {% endif %}
      </dl>

      <p class="ficha-sinopsis" data-expandible>{{ sinopsis }}</p>
      <button type="button" class="btn-leer-mas" data-toggle-sinopsis>Leer más</button>
    </div>
  </div>

  {% if playlist %}
  <section class="ficha-reproductor" aria-label="Ver serie">
    <p class="ficha-reproductor-titulo">Ver serie</p>
    <div class="video-wrapper">
      <iframe src="https://www.youtube.com/embed/videoseries?list={{ playlist }}" title="{{ titulo }}" loading="lazy" allowfullscreen></iframe>
    </div>
  </section>
  {% elif videos and videos.length > 1 %}
  {# Serie con varias partes: UN solo reproductor + "Episodio anterior / siguiente".
     No se listan todas las partes (hay series con 20 o más). #}
  <section class="ficha-reproductor" aria-label="Ver serie" data-ficha-partes data-videos="{{ videos | join(',') }}">
    <p class="ficha-reproductor-titulo">Ver serie · <span data-ficha-parte-label>Parte 1 de {{ videos.length }}</span></p>
    <div class="video-wrapper">
      <iframe id="ficha-partes-iframe" src="https://www.youtube.com/embed/{{ videos[0] }}?enablejsapi=1&playsinline=1&rel=0" title="{{ titulo }} - Parte 1" loading="lazy" allow="autoplay; fullscreen" allowfullscreen></iframe>
    </div>
    <div class="reproductor-nav" data-ficha-nav>
      <button type="button" class="btn-nav-episodio" data-nav="prev" disabled>‹ <span class="txt-largo">Episodio </span>anterior</button>
      <span class="reproductor-corazon" aria-hidden="true">
        <img src="/assets/icons/corazon.png" alt="" width="40" height="37">
      </span>
      <button type="button" class="btn-nav-episodio" data-nav="next"><span class="txt-largo">Episodio </span>siguiente ›</button>
    </div>
  </section>
  {% elif videos %}
  <section class="ficha-reproductor" aria-label="Ver serie">
    <p class="ficha-reproductor-titulo">Ver serie</p>
    <div class="video-wrapper">
      <iframe src="https://www.youtube.com/embed/{{ videos[0] }}" title="{{ titulo }}" loading="lazy" allowfullscreen></iframe>
    </div>
  </section>
  {% else %}
  <section class="ficha-reproductor" aria-label="Tráiler">
    <p class="ficha-reproductor-titulo">Tráiler</p>
    <div class="video-wrapper">
      <iframe src="https://www.youtube.com/embed/{{ youtubeId }}" title="Tráiler de {{ titulo }}" loading="lazy" allowfullscreen></iframe>
    </div>
  </section>
  {% endif %}
</article>

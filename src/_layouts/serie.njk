---
layout: base.njk
---
<article class="ficha-serie">
  <div class="ficha-serie-cabecera">
    <img src="{{ portada }}" alt="Portada de {{ titulo }}" width="300" height="450" class="ficha-portada">
    <div class="ficha-info">
      <h1>{{ titulo }} <span class="ficha-anio">({{ anio }})</span></h1>

      <dl class="ficha-datos">
        {% if genero %}
        <div class="ficha-dato">
          <dt>Género</dt>
          <dd>{{ genero }}</dd>
        </div>
        {% endif %}
        {% if reparto and reparto.length %}
        <div class="ficha-dato">
          <dt>Reparto</dt>
          <dd>{{ reparto | join(", ") }}</dd>
        </div>
        {% endif %}
        {% if puntaje %}
        <div class="ficha-dato">
          <dt>Puntaje</dt>
          <dd>⭐ {{ puntaje }}/10</dd>
        </div>
        {% endif %}
      </dl>

      <p class="ficha-sinopsis" data-expandible>{{ sinopsis }}</p>
      <button type="button" class="btn-leer-mas" data-toggle-sinopsis>Leer más</button>
    </div>
  </div>

  <section class="ficha-reproductor" aria-label="Tráiler">
    <p class="ficha-reproductor-titulo">Tráiler</p>
    <div class="video-wrapper">
      <iframe src="https://www.youtube.com/embed/{{ youtubeId }}" title="Tráiler de {{ titulo }}" loading="lazy" allowfullscreen></iframe>
    </div>
  </section>
</article>
